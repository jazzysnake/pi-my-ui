# Copy to .env beside this file and replace every value. .env is git-ignored; this example is not.

# The user the containers run as: the owner of ~/.pi and of the Projects. `id -u` and `id -g`.
PI_MY_UI_UID=1000
PI_MY_UI_GID=1000

# Absolute paths, mounted at the same path inside the containers. A Project is an absolute path, so
# these cannot be shortened to /work or /projects.
PI_MY_UI_HOME=/home/you
PI_MY_UI_REPO=/home/you/pi-my-ui
PI_MY_UI_WORKSPACE=/home/you/projects

# The name this machine answers to on the tailnet, which is also the browser origin, and the
# addresses Caddy binds: `tailscale status --json` for the name, `tailscale ip -4` and `ip -6` for
# the addresses.
PI_MY_UI_TAILNET_NAME=laptop.tailnet-name.ts.net
PI_MY_UI_TAILNET_IPV4=100.64.0.1
PI_MY_UI_TAILNET_IPV6=fd7a:115c:a1e0::1

# The backend port. One value feeds the server's --port and Caddy's upstream, so they cannot drift.
PI_MY_UI_PORT=8787

# Every Project the phone may open, as repeated --project flags. A mount does not make something a
# Project, Projects may not nest, and this list is quoted because it holds a space. Paths themselves
# may not contain a space.
PI_MY_UI_PROJECTS="--project /home/you/projects/api --project /home/you/pi-my-ui"
