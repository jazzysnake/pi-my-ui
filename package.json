{
  "name": "pi-my-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Phone-first web UI for pi.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "workspaces": [
    "packages/protocol",
    "packages/server",
    "packages/client",
    "packages/bridge-extension",
    "packages/scripted-provider",
    "packages/e2e"
  ],
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "build:protocol": "npm run build --workspace @pi-my-ui/protocol",
    "typecheck": "npm run build:protocol && npm run typecheck --workspaces --if-present",
    "lint": "eslint . && node scripts/hygiene-check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:protocol && npm run test --workspaces --if-present",
    "build": "npm run build:protocol && npm run build --workspaces --if-present",
    "test:e2e": "playwright test --config packages/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@tintinweb/pi-subagents": "0.22.0"
  }
}
