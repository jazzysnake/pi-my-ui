{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "test/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
